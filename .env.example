# Supabase > Project Settings > API (MISMO proyecto que el formulario)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Para el reporte por correo:
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-SECRETA
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Barceló Guatemala City <reportes@promocionesgt.download>
REPORTE_TO=gerencia@ejemplo.com
# Separa varios destinatarios con coma: uno@x.com,dos@y.com

# Protege la tarea programada (ponle un texto largo al azar).
# Vercel lo envía como Authorization: Bearer <CRON_SECRET> al cron.
CRON_SECRET=pon-aqui-un-secreto-largo-al-azar
